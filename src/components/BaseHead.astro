---
import '../styles/normalize.css';
import '../styles/all.scss';
import '../styles/menu.scss';
import '../styles/footer.scss';

const { title } = Astro.props;
---
<meta charset="utf-8" />

<!-- Global site tag (gtag.js) - Google Analytics -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=UA-49301476-1"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'UA-49301476-1');
</script>

<meta content="IE=edge,chrome=1" http-equiv="X-UA-Compatible" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="Shuyang is a software engineer working on AI systems. He is based in New York." />
<meta name="author" content="Shuyang Li" />

<title>{title ? `${title} | Shuyang Li` : 'Shuyang Li'}</title>

<!-- jQuery (required by Bootstrap) -->
<script is:inline src="https://code.jquery.com/jquery-1.11.3.min.js"></script>

<!-- Bootstrap -->
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css" integrity="sha384-1q8mTJOASx8j1Au+a5WDVnPi2lkFfwwEAa8hDDdjZlpLegxhjVME1fgjWPGmkzs7" crossorigin="anonymous" />
<script is:inline src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/js/bootstrap.min.js" integrity="sha384-0mSbJDEHialfmuBBQP6A4Qrprq5OVfW37PRR3j5ELqxss1yVqOtnepnHVP9aJ7xS" crossorigin="anonymous"></script>

<!-- FontAwesome -->
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.5.0/css/font-awesome.min.css" />

<script is:inline src="/javascripts/all.js"></script>
<script is:inline src="/javascripts/email.js"></script>
